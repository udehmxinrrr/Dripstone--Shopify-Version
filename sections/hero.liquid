<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=JetBrains+Mono:wght@500;600;700&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet">

<section class="dh-hero" id="hero">
  <div class="dh-marquee">
    <div class="dh-marquee__track">
      {%- for i in (1..3) -%}
        <span>{{ section.settings.marquee_1 }}</span>
        <span>{{ section.settings.marquee_2 }}</span>
        <span>{{ section.settings.marquee_3 }}</span>
      {%- endfor -%}
    </div>
  </div>

  <div class="dh-hero__main">
    <div class="dh-copy">
      <div class="dh-eyebrow">{{ section.settings.eyebrow }}</div>
      <h1 class="dh-headline">
        {{ section.settings.line_1 }}<br>
        <span class="dh-accent">{{ section.settings.line_2 }}</span><br>
        <span class="dh-outline">{{ section.settings.line_3 }}</span>
      </h1>
      <p class="dh-sub">{{ section.settings.subtext }}</p>
      <div class="dh-cta-row">
        <a href="{{ section.settings.button_link | default: '/collections/all' }}" class="dh-btn-primary">
          {{ section.settings.button_label }}
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
            <path d="M2 8H14M14 8L9 3M14 8L9 13" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </div>
    </div>

    <div class="dh-stage">
      <div class="dh-plate">
        {%- if section.settings.image != blank -%}
          {{ section.settings.image | image_url: width: 900 | image_tag: class: 'dh-plate__img', loading: 'eager', alt: section.settings.image.alt }}
        {%- else -%}
          <svg class="dh-plate__art" viewBox="0 0 200 200" fill="none" xmlns="http://www.w3.org/2000/svg">
            <circle cx="100" cy="100" r="86" fill="none" stroke="#C6F135" stroke-width="1.5" stroke-dasharray="4 6" opacity="0.5"/>
            <path d="M60 130 C60 100, 75 70, 110 65 C135 61, 150 75, 150 95 C150 115, 130 125, 130 135 L60 135 Z" fill="#FF6B35" opacity="0.9"/>
            <path d="M60 130 L150 130 L150 145 C150 150 145 152 138 152 L68 152 C62 152 60 149 60 145 Z" fill="#FFF8ED"/>
          </svg>
        {%- endif -%}

        <div class="dh-tag dh-tag--1">
          <span class="dh-tag__label">{{ section.settings.tag_1_label }}</span>
          <span class="dh-tag__price"><span class="dh-was">{{ section.settings.tag_1_was }}</span>{{ section.settings.tag_1_price }}</span>
        </div>

        <div class="dh-tag dh-tag--2">
          <span class="dh-tag__label">{{ section.settings.tag_2_label }}</span>
          <span class="dh-tag__price">{{ section.settings.tag_2_price }}</span>
        </div>

        <div class="dh-stock-pill"><span class="dh-dot"></span> {{ section.settings.stock_text }}</div>
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
  .dh-hero {
    --bg: #0E1A17;
    --bg-soft: #142621;
    --tangerine: #FF6B35;
    --lime: #C6F135;
    --hotpink: #FF2E63;
    --cream: #FFF8ED;
    --cream-dim: #C9C2B3;
    --line: rgba(255,248,237,0.14);

    position: relative;
    min-height: 500px;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    font-family: 'Space Grotesk', sans-serif;
    background:
      radial-gradient(ellipse 900px 500px at 82% 18%, rgba(255,107,53,0.20), transparent 60%),
      radial-gradient(ellipse 700px 500px at 10% 85%, rgba(198,241,53,0.10), transparent 60%),
      var(--bg);
  }
  .dh-hero *, .dh-hero *::before, .dh-hero *::after { box-sizing: border-box; }

  /* ---- marquee band ---- */
  .dh-marquee {
    position: absolute;
    left: -8%;
    width: 116%;
    top: 40%;
    transform: rotate(-4deg);
    background: var(--tangerine);
    padding: 14px 0;
    z-index: 2;
    box-shadow: 0 20px 60px rgba(255,107,53,0.25);
    overflow: hidden;
  }
  .dh-marquee__track {
    display: flex;
    width: max-content;
    animation: dh-scroll-left 26s linear infinite;
  }
  .dh-marquee__track span {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 22px;
    letter-spacing: 3px;
    color: var(--bg);
    padding: 0 28px;
    white-space: nowrap;
    display: flex;
    align-items: center;
    gap: 28px;
  }
  .dh-marquee__track span::after {
    content: '●';
    font-size: 8px;
    color: var(--bg);
    opacity: .6;
  }
  @keyframes dh-scroll-left {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }

  /* ---- main grid ---- */
  .dh-hero__main {
    position: relative;
    flex: 1;
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    align-items: center;
    padding: 0 6vw 60px;
    gap: 40px;
    z-index: 3;
  }

  /* ---- copy (left column) ---- */
  .dh-copy {
    position: relative;
    z-index: 4;
    padding-top: 20px;
  }
  .dh-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 1.5px;
    color: var(--lime);
    background: rgba(198,241,53,0.08);
    border: 1px solid rgba(198,241,53,0.3);
    padding: 7px 14px;
    border-radius: 999px;
    margin-bottom: 28px;
  }
  .dh-eyebrow::before {
    content: '';
    width: 7px; height: 7px;
    background: var(--lime);
    border-radius: 50%;
    box-shadow: 0 0 10px var(--lime);
  }
  .dh-headline {
    font-family: 'Bebas Neue', sans-serif;
    font-weight: 400;
    font-size: clamp(64px, 9vw, 130px);
    line-height: 0.85;
    letter-spacing: 1px;
    color: var(--cream);
    margin: 0 0 8px;
    text-transform: none;
  }
  .dh-headline .dh-accent { color: var(--tangerine); }
  .dh-headline .dh-outline {
    color: transparent;
    -webkit-text-stroke: 2px var(--cream);
  }
  @media (max-width: 960px) {
    .dh-headline .dh-outline {
      -webkit-text-stroke: 1px var(--cream);
      text-shadow:
        -1px -1px 0 var(--cream),
         1px -1px 0 var(--cream),
        -1px  1px 0 var(--cream),
         1px  1px 0 var(--cream);
    }
  }
  .dh-sub {
    max-width: 440px;
    font-size: 17px;
    line-height: 1.6;
    color: var(--cream-dim);
    margin: 28px 0 40px;
    font-weight: 400;
  }
  .dh-cta-row {
    display: flex;
    align-items: center;
    gap: 22px;
    flex-wrap: wrap;
  }
  .dh-btn-primary {
    position: relative;
    background: var(--lime);
    color: var(--bg);
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 700;
    font-size: 15px;
    padding: 18px 34px;
    border-radius: 10px;
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 10px;
    transition: transform .2s ease, box-shadow .2s ease;
    box-shadow: 0 8px 0 rgba(0,0,0,0.25);
    text-decoration: none;
  }
  .dh-btn-primary:hover {
    transform: translateY(-3px);
    box-shadow: 0 11px 0 rgba(0,0,0,0.25);
  }
  .dh-btn-primary:active {
    transform: translateY(2px);
    box-shadow: 0 3px 0 rgba(0,0,0,0.25);
  }
  .dh-btn-primary svg { transition: transform .2s ease; }
  .dh-btn-primary:hover svg { transform: translateX(4px); }
  .dh-btn-primary:focus-visible {
    outline: 2px solid var(--lime);
    outline-offset: 3px;
  }

  /* ---- stage (right column) ---- */
  .dh-stage {
    position: relative;
    z-index: 3;
    display: flex;
    align-items: center;
    justify-content: center;
    height: 560px;
  }
  .dh-plate {
    position: relative;
    width: 420px;
    height: 420px;
    border-radius: 32px;
    background: linear-gradient(155deg, var(--bg-soft), #0A1512);
    border: 1px solid var(--line);
    display: flex;
    align-items: center;
    justify-content: center;
    transform: rotate(3deg);
    box-shadow: 0 40px 80px rgba(0,0,0,0.45);
  }
  .dh-plate__img,
  .dh-plate__art {
    width: 82%;
    height: auto;
    object-fit: contain;
    filter: drop-shadow(0 30px 40px rgba(0,0,0,0.5));
    transform: rotate(-3deg);
  }
  .dh-plate__img {
    border-radius: 20px;
  }

  /* price tags */
  .dh-tag {
    position: absolute;
    background: var(--cream);
    color: var(--bg);
    font-family: 'JetBrains Mono', monospace;
    font-weight: 700;
    border-radius: 12px;
    padding: 14px 16px;
    box-shadow: 0 14px 30px rgba(0,0,0,0.35);
    display: flex;
    flex-direction: column;
    gap: 2px;
    line-height: 1.1;
  }
  .dh-tag__price { font-size: 20px; }
  .dh-tag__price .dh-was {
    font-size: 12px;
    color: #8b8578;
    text-decoration: line-through;
    font-weight: 500;
    margin-right: 6px;
  }
  .dh-tag__label {
    font-size: 10px;
    letter-spacing: 1px;
    color: var(--hotpink);
    text-transform: uppercase;
  }
  .dh-tag--1 { top: -6%; left: -10%; transform: rotate(-8deg); }
  .dh-tag--2 {
    bottom: -8%; right: -6%; transform: rotate(6deg);
    background: var(--hotpink);
    color: var(--cream);
  }
  .dh-tag--2 .dh-tag__label { color: var(--cream); opacity: .75; }

  .dh-stock-pill {
    position: absolute;
    top: 8%;
    right: -8%;
    background: var(--bg);
    border: 1px solid var(--line);
    color: var(--cream);
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    padding: 8px 12px;
    border-radius: 999px;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .dh-stock-pill .dh-dot {
    width: 6px; height: 6px; border-radius: 50%;
    background: var(--tangerine);
    animation: dh-pulse 1.6s ease-in-out infinite;
  }
  @keyframes dh-pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: .4; transform: scale(0.7); }
  }

  /* ---- responsive ---- */
  @media (max-width: 900px) {
    .dh-hero__main { grid-template-columns: 1fr; padding-top: 40px; }
    .dh-stage { height: 380px; order: -1; }
    .dh-plate { width: 300px; height: 300px; }
    .dh-marquee { top: auto; bottom: 6%; }
  }
  @media (prefers-reduced-motion: reduce) {
    .dh-marquee__track { animation: none; }
    .dh-stock-pill .dh-dot { animation: none; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Dripstone Hero",
  "settings": [
    { "type": "header", "content": "Marquee band" },
    { "type": "text", "id": "marquee_1", "label": "Message 1", "default": "NEW DROP JUST LANDED" },
    { "type": "text", "id": "marquee_2", "label": "Message 2", "default": "FREE SHIPPING OVER $75" },
    { "type": "text", "id": "marquee_3", "label": "Message 3", "default": "LIMITED STOCK — MOVE FAST" },

    { "type": "header", "content": "Copy" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "DROP 014 — LIVE NOW" },
    { "type": "text", "id": "line_1", "label": "Headline line 1", "default": "NEW" },
    { "type": "text", "id": "line_2", "label": "Headline line 2 (orange)", "default": "DROP." },
    { "type": "text", "id": "line_3", "label": "Headline line 3 (outlined)", "default": "JUST LANDED." },
    { "type": "textarea", "id": "subtext", "label": "Subtext", "default": "112 pieces. No restocks. Everything you see sells out by Friday — the ones who move first get to keep it." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop the Drop" },
    { "type": "url", "id": "button_link", "label": "Button link" },

    { "type": "header", "content": "Product plate" },
    { "type": "image_picker", "id": "image", "label": "Product image" },
    { "type": "text", "id": "tag_1_label", "label": "Tag 1 label", "default": "Best seller" },
    { "type": "text", "id": "tag_1_was", "label": "Tag 1 old price", "default": "$129" },
    { "type": "text", "id": "tag_1_price", "label": "Tag 1 price", "default": "$89" },
    { "type": "text", "id": "tag_2_label", "label": "Tag 2 label", "default": "Only 6 left" },
    { "type": "text", "id": "tag_2_price", "label": "Tag 2 price", "default": "$64" },
    { "type": "text", "id": "stock_text", "label": "Stock pill text", "default": "214 sold today" }
  ],
  "presets": [{ "name": "Dripstone Hero" }]
}
{% endschema %}