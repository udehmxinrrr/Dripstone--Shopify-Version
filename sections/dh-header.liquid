<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">

{%- assign brand_name = section.settings.brand_name | default: shop.name -%}
{%- assign brand_mark = section.settings.brand_mark | default: brand_name | slice: 0 -%}

<header class="dh-header" id="dh-header-{{ section.id }}">
  <nav class="dh-navbar">
    <a href="{{ routes.root_url }}" class="dh-brand">
      <span class="dh-brand__mark">{{ brand_mark }}</span>
      <span class="dh-brand__name">{{ brand_name }}</span>
    </a>

    <ul class="dh-nav-links">
      {%- for link in linklists[section.settings.menu].links -%}
        <li>
          <a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title }}</a>
        </li>
      {%- endfor -%}
    </ul>

    <div class="dh-search-wrap">
      <form class="dh-search-box" action="{{ routes.search_url }}" method="get" role="search">
        <input type="hidden" name="type" value="product">
        <button type="submit" class="dh-search-icon-btn" aria-label="Search" aria-expanded="false">
          <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="7"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
        </button>
        <input type="text" name="q" class="dh-search-input" placeholder="Search products" autocomplete="off" value="{{ search.terms | escape }}">
        <button type="button" class="dh-search-clear" aria-label="Clear search">&times;</button>
      </form>
    </div>

    <div class="dh-nav-icons">
      <a href="{{ routes.cart_url }}" class="dh-icon-btn" aria-label="Cart">
        <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"></path>
          <path d="M3 6h18"></path>
          <path d="M16 10a4 4 0 0 1-8 0"></path>
        </svg>
        <span class="dh-cart-badge">{{ cart.item_count }}</span>
      </a>
      <button type="button" class="dh-hamburger" aria-label="Toggle menu" aria-expanded="false">
        <span></span><span></span><span></span>
      </button>
    </div>
  </nav>
</header>

{% stylesheet %}
  /* keep the header stuck to the top of the page */
  .shopify-section:has(> .dh-header) {
    position: sticky;
    top: 0;
    z-index: 1000;
  }

  .dh-header {
    --bg: #0E1A17;
    --bg-soft: #142621;
    --tangerine: #FF6B35;
    --lime: #C6F135;
    --white: #ffffff;
    --muted: #a8b3af;
    --line: rgba(255,248,237,0.14);

    position: relative;
    height: 72px;
    background: var(--bg);
    font-family: 'Inter', sans-serif;
  }
  .dh-header *, .dh-header *::before, .dh-header *::after { box-sizing: border-box; }

  .dh-navbar {
    max-width: 1300px;
    height: 100%;
    margin: 0 auto;
    display: flex;
    align-items: center;
    gap: clamp(1rem, 3vw, 2.5rem);
    padding: 0.9rem clamp(1rem, 4vw, 2rem);
  }

  /* ---- brand ---- */
  .dh-brand {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    flex-shrink: 0;
    margin: 0;
  }
  .dh-brand__mark {
    width: 34px;
    height: 34px;
    border-radius: 8px;
    background: var(--tangerine);
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 1.05rem;
    color: var(--bg);
    text-transform: uppercase;
  }
  .dh-brand__name {
    font-family: 'Playfair Display', serif;
    font-weight: 700;
    font-size: 1.15rem;
    color: var(--white);
    letter-spacing: 0.5px;
  }

  /* ---- links ---- */
  .dh-nav-links {
    display: flex;
    align-items: center;
    gap: 1.75rem;
    list-style: none;
    margin: 0;
    padding: 0;
    flex-shrink: 0;
  }
  .dh-nav-links a {
    color: var(--white);
    text-decoration: none;
    font-weight: 500;
    font-size: 0.9rem;
    position: relative;
    padding: 0.25rem 0;
    transition: color 0.2s ease;
  }
  .dh-nav-links a::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -2px;
    width: 0;
    height: 2px;
    background: var(--tangerine);
    transition: width 0.25s ease;
  }
  .dh-nav-links a:hover { color: var(--tangerine); }
  .dh-nav-links a:hover::after,
  .dh-nav-links a[aria-current="page"]::after { width: 100%; }

  /* ---- search ---- */
  .dh-search-wrap {
    position: relative;
    flex: 1;
    max-width: 460px;
    margin-left: auto;
  }
  .dh-search-box {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin: 0;
    background: var(--bg-soft);
    border: 1px solid var(--bg-soft);
    border-radius: 8px;
    padding: 0.55rem 0.9rem;
    transition: border-color 0.2s ease;
  }
  .dh-search-box:focus-within { border-color: var(--lime); }
  .dh-search-box svg {
    flex-shrink: 0;
    width: 16px;
    height: 16px;
    stroke: var(--lime);
  }
  .dh-search-icon-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    border: none;
    padding: 0;
    margin: 0;
    cursor: pointer;
    flex-shrink: 0;
  }
  .dh-search-icon-btn svg { pointer-events: none; }
  .dh-search-input {
    flex: 1;
    min-width: 0;
    width: 100%;
    height: auto;
    min-height: 0;
    background: none;
    border: none;
    box-shadow: none;
    outline: none;
    padding: 0;
    margin: 0;
    color: var(--white);
    font-family: 'Inter', sans-serif;
    font-size: 0.88rem;
  }
  .dh-search-input::placeholder { color: var(--muted); opacity: 1; }
  .dh-search-clear {
    display: none;
    background: none;
    border: none;
    color: var(--lime);
    cursor: pointer;
    font-size: 1rem;
    line-height: 1;
    padding: 0;
  }
  .dh-search-clear.is-visible { display: block; }

  /* ---- icons ---- */
  .dh-nav-icons {
    display: flex;
    align-items: center;
    gap: 1.1rem;
    flex-shrink: 0;
  }
  .dh-icon-btn {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    color: var(--white);
    text-decoration: none;
    transition: background 0.2s ease;
  }
  .dh-icon-btn:hover { background: var(--bg-soft); }
  .dh-icon-btn svg {
    width: 19px;
    height: 19px;
    stroke: currentColor;
  }
  .dh-cart-badge {
    position: absolute;
    top: 2px;
    right: 2px;
    background: var(--tangerine);
    color: var(--bg);
    font-size: 0.6rem;
    font-weight: 700;
    min-width: 15px;
    height: 15px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 3px;
  }

  .dh-hamburger {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 6px;
  }
  .dh-hamburger span {
    width: 22px;
    height: 2px;
    background: var(--white);
    border-radius: 2px;
    transition: transform 0.25s ease, opacity 0.25s ease;
  }
  .dh-hamburger.is-active span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  .dh-hamburger.is-active span:nth-child(2) { opacity: 0; }
  .dh-hamburger.is-active span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

  .dh-header a:focus-visible,
  .dh-header button:focus-visible {
    outline: 2px solid var(--lime);
    outline-offset: 3px;
  }

  /* ---- tablet / mobile ---- */
  @media (max-width: 900px) {
    .dh-hamburger { display: flex; }
    .dh-nav-links {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: flex-start;
      gap: 1.25rem;
      padding: 1.5rem clamp(1rem, 4vw, 2rem);
      background: var(--bg);
      border-top: 1px solid var(--line);
      box-shadow: 0 20px 40px rgba(0,0,0,0.4);
    }
    .dh-header.is-open .dh-nav-links { display: flex; }
    .dh-nav-links a { font-size: 1.05rem; }
  }

  @media (max-width: 600px) {
    /* search collapses to an icon, expands over the navbar when tapped */
    .dh-search-wrap { flex: 0 0 auto; margin-left: auto; }
    .dh-search-box { padding: 0.55rem; }
    .dh-search-input { display: none; }
    .dh-search-wrap.is-open {
      position: absolute;
      left: 1rem;
      right: 1rem;
      top: 50%;
      transform: translateY(-50%);
      max-width: none;
      z-index: 2;
      background: var(--bg);
    }
    .dh-search-wrap.is-open .dh-search-box { padding: 0.55rem 0.9rem; }
    .dh-search-wrap.is-open .dh-search-input { display: block; }
    .dh-nav-icons { gap: 0.4rem; }
  }
{% endstylesheet %}

<script>
  (function () {
    var header = document.getElementById('dh-header-{{ section.id }}');
    if (!header) return;

    var hamburger = header.querySelector('.dh-hamburger');
    var wrap = header.querySelector('.dh-search-wrap');
    var form = header.querySelector('.dh-search-box');
    var input = header.querySelector('.dh-search-input');
    var iconBtn = header.querySelector('.dh-search-icon-btn');
    var clearBtn = header.querySelector('.dh-search-clear');
    var narrow = window.matchMedia('(max-width: 600px)');

    hamburger.addEventListener('click', function () {
      var open = header.classList.toggle('is-open');
      hamburger.classList.toggle('is-active', open);
      hamburger.setAttribute('aria-expanded', open);
    });

    function syncClear() {
      clearBtn.classList.toggle('is-visible', input.value.length > 0);
    }
    input.addEventListener('input', syncClear);
    syncClear();

    clearBtn.addEventListener('click', function () {
      input.value = '';
      syncClear();
      input.focus();
      if (narrow.matches) {
        wrap.classList.remove('is-open');
        iconBtn.setAttribute('aria-expanded', 'false');
      }
    });

    iconBtn.addEventListener('click', function (e) {
      if (narrow.matches && !wrap.classList.contains('is-open')) {
        e.preventDefault();
        wrap.classList.add('is-open');
        iconBtn.setAttribute('aria-expanded', 'true');
        input.focus();
      } else if (!input.value.trim()) {
        e.preventDefault();
        input.focus();
      }
    });
  })();
</script>

{% schema %}
{
  "name": "Dripstone Header",
  "settings": [
    { "type": "link_list", "id": "menu", "label": "Menu", "default": "main-menu" },
    { "type": "text", "id": "brand_name", "label": "Brand name", "info": "Leave empty to use the store name." },
    { "type": "text", "id": "brand_mark", "label": "Brand mark letter", "info": "Leave empty to use the first letter of the brand name." }
  ],
  "presets": [{ "name": "Dripstone Header" }]
}
{% endschema %}