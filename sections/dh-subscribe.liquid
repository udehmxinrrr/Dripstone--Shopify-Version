<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=JetBrains+Mono:wght@500&family=Space+Grotesk:wght@700&family=Inter:wght@400;500&display=swap" rel="stylesheet">

<section class="dh-subscribe" id="subscribe">
  <div class="dh-subscribe__inner">
    <div class="dh-subscribe__copy">
      {%- if section.settings.eyebrow != blank -%}
        <span class="dh-subscribe__eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      <h2 class="dh-subscribe__title">{{ section.settings.title_a }} <span class="dh-outline">{{ section.settings.title_b }}</span></h2>
      {%- if section.settings.subtext != blank -%}
        <p class="dh-subscribe__sub">{{ section.settings.subtext }}</p>
      {%- endif -%}
    </div>

    {%- form 'customer', id: 'dh-subscribe-form', class: 'dh-subscribe__form' -%}
      {%- if form.posted_successfully? -%}
        <p class="dh-subscribe__msg" role="status">{{ section.settings.success_message }}</p>
      {%- else -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <div class="dh-subscribe__input-wrap">
          <input
            type="email"
            name="contact[email]"
            id="dh-subscribe-email"
            placeholder="{{ section.settings.placeholder | escape }}"
            aria-label="{{ section.settings.placeholder | escape }}"
            autocomplete="email"
            value="{{ form.email }}"
            required>
          <button type="submit" class="dh-btn-subscribe">
            {{ section.settings.button_label }}
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
              <path d="M2 8H14M14 8L9 3M14 8L9 13" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
        </div>
        {%- if form.errors -%}
          <p class="dh-subscribe__msg dh-subscribe__msg--error" role="alert">{{ section.settings.error_message }}</p>
        {%- endif -%}
      {%- endif -%}
    {%- endform -%}
  </div>
</section>

{% stylesheet %}
  .dh-subscribe {
    --bg: #0E1A17;
    --bg-soft: #142621;
    --tangerine: #FF6B35;
    --lime: #C6F135;
    --hotpink: #FF2E63;
    --cream: #FFF8ED;
    --cream-dim: #C9C2B3;
    --line: rgba(255,248,237,0.14);

    background: var(--bg-soft);
    border-top: 1px dashed var(--line);
    border-bottom: 1px dashed var(--line);
    padding: clamp(3rem, 8vw, 5rem) clamp(1.5rem, 4vw, 3rem);
    font-family: 'Inter', sans-serif;
    scroll-margin-top: 72px;
  }
  .dh-subscribe *, .dh-subscribe *::before, .dh-subscribe *::after { box-sizing: border-box; }
  #dh-subscribe-form { scroll-margin-top: 120px; }

  .dh-subscribe__inner {
    max-width: 1100px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }

  .dh-subscribe__eyebrow {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: #ffffff;
    margin-bottom: 0.6rem;
  }
  .dh-subscribe__title {
    font-family: 'Bebas Neue', sans-serif;
    font-weight: 400;
    font-size: clamp(40px, 6vw, 64px);
    line-height: 0.95;
    color: var(--cream);
    letter-spacing: 1px;
    margin: 0.5rem 0 1rem;
    text-transform: none;
  }
  .dh-subscribe__title .dh-outline {
    color: transparent;
    -webkit-text-stroke: 2.5px var(--tangerine);
  }
  @media (max-width: 960px) {
    .dh-subscribe__title .dh-outline {
      text-shadow:
        -1px -1px 0 var(--tangerine),
         1px -1px 0 var(--tangerine),
        -1px  1px 0 var(--tangerine),
         1px  1px 0 var(--tangerine);
    }
  }
  .dh-subscribe__sub {
    font-size: 15px;
    color: var(--cream-dim);
    max-width: 40ch;
    margin: 0;
  }

  .dh-subscribe__form {
    width: 100%;
    margin: 0;
    perspective: 500px;
  }
  .dh-subscribe__input-wrap {
    display: flex;
    gap: 0.6rem;
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 6px;
  }
  .dh-subscribe__input-wrap input[type="email"] {
    flex: 1;
    min-width: 0;
    height: auto;
    min-height: 0;
    background: transparent;
    border: none;
    box-shadow: none;
    outline: none;
    color: var(--cream);
    font-family: 'Inter', sans-serif;
    font-size: 14px;
    padding: 10px 12px;
    margin: 0;
  }
  .dh-subscribe__input-wrap input::placeholder {
    color: var(--cream-dim);
    opacity: 1;
  }
  .dh-btn-subscribe {
    flex-shrink: 0;
    background: var(--lime);
    color: var(--bg);
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 700;
    font-size: 13px;
    border: none;
    border-radius: 8px;
    padding: 0 18px;
    min-height: 40px;
    display: flex;
    align-items: center;
    gap: 6px;
    cursor: pointer;
    transition: transform 0.2s ease;
  }
  .dh-btn-subscribe:hover { transform: translateZ(20px) scale(1.03); }
  .dh-btn-subscribe:active { transform: translateZ(5px) scale(0.98); }

  .dh-subscribe__msg {
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    letter-spacing: 0.5px;
    margin: 0.7rem 0 0;
    color: var(--lime);
  }
  .dh-subscribe__msg--error { color: var(--hotpink); }

  .dh-subscribe a:focus-visible,
  .dh-subscribe button:focus-visible {
    outline: 2px solid var(--lime);
    outline-offset: 3px;
  }

  @media (max-width: 700px) {
    .dh-subscribe__inner {
      grid-template-columns: 1fr;
      text-align: center;
    }
    .dh-subscribe__sub { margin: 0 auto; }
    .dh-subscribe__input-wrap { flex-direction: column; }
    .dh-btn-subscribe { padding: 12px 0; justify-content: center; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Dripstone Subscribe",
  "settings": [
    { "type": "header", "content": "Copy" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Don't miss the next drop" },
    { "type": "text", "id": "title_a", "label": "Title, first part", "default": "Get In" },
    { "type": "text", "id": "title_b", "label": "Title, outlined part", "default": "Early." },
    { "type": "textarea", "id": "subtext", "label": "Subtext", "default": "Restock alerts, early access, and the occasional discount code. No spam, unsubscribe anytime." },

    { "type": "header", "content": "Form" },
    { "type": "text", "id": "placeholder", "label": "Email placeholder", "default": "Enter your email" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Subscribe" },
    { "type": "text", "id": "success_message", "label": "Success message", "default": "You're in. Watch your inbox for the next drop." },
    { "type": "text", "id": "error_message", "label": "Error message", "default": "Please enter a valid email address." }
  ],
  "presets": [{ "name": "Dripstone Subscribe" }]
}
{% endschema %}